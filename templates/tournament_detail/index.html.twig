{% extends 'base.html.twig' %}

{% block title %}Détails du Tournoi - {{ tournament.name }}{% endblock %}

{% block body %}
<div class="container">
    <h2>{{ tournament.name }}</h2>

    <p><strong>Description :</strong> {{ tournament.description }}</p>
    <p><strong>Début du tournoi :</strong> {{ tournament.startDate|date('d/m/Y') }}</p>
    <p><strong>Ouverture des inscriptions :</strong> {{ tournament.registrationStartDate|date('d/m/Y') }}</p>
    <p><strong>Fermeture des inscriptions :</strong> {{ tournament.registrationEndDate|date('d/m/Y') }}</p>
    <p><strong>Nombre maximum d'équipes :</strong> {{ tournament.maxTeams ?? 'Non défini' }}</p>
    <p><strong>Statut :</strong> {{ tournament.status }}</p>
    <p><strong>Créé le :</strong> {{ tournament.createdAt|date('d/m/Y H:i') }}</p>

    <a href="{{ path('app_tournaments') }}" class="btn">Retour à la liste des tournois</a>
</div>
{% endblock %}
